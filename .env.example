# Public Supabase project URL
SUPABASE_URL=

# Public anon key for client-side/API calls
SUPABASE_ANON_KEY=

# Private service role key. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=

# New Supabase secret key format. Keep this secret.
SUPABASE_SECRET_KEY=

# Supabase CLI access token. Keep this secret.
SUPABASE_ACCESS_TOKEN=

# Supabase project ref, for example abcdefghijklmnopqrst
SUPABASE_PROJECT_REF=
